# Copy this file to .env and fill in real values

PORT=5000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=planner_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Content-safety lockout settings
FLAG_WINDOW_MINUTES=10
FLAG_THRESHOLD=3
LOCK_DURATION_MINUTES=60

# Cutoff hour (24h format) after which "plan not revised" notification fires
PLAN_REVISION_CUTOFF_HOUR=21
